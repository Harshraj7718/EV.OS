VITE_API_URL=http://localhost:5000/api

# Razorpay TEST MODE public key only — never put the key secret here.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# Set to "true" to take the site down and show the maintenance page instead of the normal app.
# Requires a redeploy to take effect (Vite bakes env vars in at build time).
VITE_MAINTENANCE_MODE=false
