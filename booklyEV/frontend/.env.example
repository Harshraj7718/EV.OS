# Base URL the browser uses to reach the backend API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Only set this on a portal-scoped Vercel deployment — one of:
#   super-admin | admin | investor | rider | business
# Leave unset for local dev / Docker Compose (serves the full app).
# See docs/vercel-deployment.md.
# NEXT_PUBLIC_PORTAL=
