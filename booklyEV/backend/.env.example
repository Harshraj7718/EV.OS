# --- Application ---
APP_NAME=booklynk-ev
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- Database (sync psycopg driver) ---
DATABASE_URL=postgresql+psycopg://booklynk:booklynk@localhost:5432/booklynk_ev
DATABASE_ECHO=false

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Auth (infrastructure ready, not wired to endpoints yet) ---
SECRET_KEY=dev-only-change-me-generate-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:3000
