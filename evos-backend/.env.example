PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/evos?retryWrites=true&w=majority
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Razorpay TEST MODE credentials only — never use live keys here.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret

# Payment webhook (optional). Register https://<your-backend>/api/payment/webhook in the Razorpay
# dashboard (Settings -> Webhooks) and paste the secret you choose there below.
RAZORPAY_WEBHOOK_SECRET=
# Verified Razorpay events are forwarded unchanged to this Interakt URL (leave blank to disable).
INTERAKT_WEBHOOK_URL=

# Admin panel login — change these before deploying.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
JWT_SECRET=generate_a_long_random_string
